          "severity": "Medium",
          "expected_outcome": "Profile scripts",
          "continue_on_failure": true
        },
        {
          "command": "cat ~/.bashrc",
          "purpose": "Inspect bash configuration",
          "severity": "Medium",
          "expected_outcome": "Shell startup commands",
          "continue_on_failure": true
        },
        {
          "command": "cat ~/.profile",
          "purpose": "Inspect user profile",
          "severity": "Medium",
          "expected_outcome": "Profile configuration",
          "continue_on_failure": true
        }
      ]
