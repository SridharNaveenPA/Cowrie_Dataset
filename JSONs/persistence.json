{
  "scenario": "Linux Persistence Enumeration",
  "description": "Simulates an attacker attempting to identify persistence opportunities and mechanisms after obtaining privileged access.",
  "version": "1.0",
  "platform": "Linux",
  "phases": [
    {
      "phase": "Current User Context",
      "mitre_tactic": "Persistence",
      "mitre_id": "TA0003",
      "commands": [
        {
          "command": "whoami",
          "purpose": "Identify current user",
          "severity": "Low",
          "expected_outcome": "Current username",
          "continue_on_failure": true
        },
        {
          "command": "id",
          "purpose": "Determine current privileges",
          "severity": "Low",
          "expected_outcome": "UID and GID information",
          "continue_on_failure": true
        },
        {
          "command": "hostname",
          "purpose": "Identify host",
          "severity": "Low",
          "expected_outcome": "Hostname",
          "continue_on_failure": true
        }
      ]
    },
    {
      "phase": "Cron Job Enumeration",
      "mitre_tactic": "Persistence",
      "mitre_id": "TA0003",
      "commands": [
        {
          "command": "crontab -l",
          "purpose": "View current user's cron jobs",
          "severity": "Medium",
          "expected_outcome": "Cron entries",
          "continue_on_failure": true
        },
        {
          "command": "ls -la /etc/cron.d",
          "purpose": "Inspect system cron jobs",
          "severity": "Medium",
          "expected_outcome": "Cron directory contents",
          "continue_on_failure": true
        },
        {
          "command": "ls -la /etc/cron.daily",
          "purpose": "Inspect daily scheduled jobs",
          "severity": "Medium",
          "expected_outcome": "Scheduled scripts",
          "continue_on_failure": true
        },
        {
          "command": "ls -la /etc/cron.hourly",
          "purpose": "Inspect hourly scheduled jobs",
          "severity": "Medium",
          "expected_outcome": "Hourly scripts",
          "continue_on_failure": true
        },
        {
          "command": "systemctl list-timers",
          "purpose": "List active system timers",
          "severity": "Medium",
          "expected_outcome": "Scheduled timers",
          "continue_on_failure": true
        }
      ]
    },
    {
      "phase": "SSH Persistence",
      "mitre_tactic": "Persistence",
      "mitre_id": "TA0003",
      "commands": [
        {
          "command": "ls -la ~/.ssh",
          "purpose": "Inspect SSH directory",
          "severity": "Medium",
          "expected_outcome": "SSH files",
          "continue_on_failure": true
        },
        {
          "command": "cat ~/.ssh/authorized_keys",
          "purpose": "View authorized SSH keys",
          "severity": "High",
          "expected_outcome": "Authorized public keys",
          "continue_on_failure": true
        },
        {
          "command": "cat ~/.ssh/config",
          "purpose": "Inspect SSH client configuration",
          "severity": "Medium",
          "expected_outcome": "SSH configuration",
          "continue_on_failure": true
        }
      ]
    },
    {
      "phase": "Systemd Services",
      "mitre_tactic": "Persistence",
      "mitre_id": "TA0003",
      "commands": [
        {
          "command": "systemctl",
          "purpose": "List available services",
          "severity": "Medium",
          "expected_outcome": "System services",
          "continue_on_failure": true
        },
        {
          "command": "systemctl list-units --type=service",
          "purpose": "List active services",
          "severity": "Medium",
          "expected_outcome": "Running services",
          "continue_on_failure": true
        },
        {
          "command": "service --status-all",
