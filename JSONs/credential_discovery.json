{
  "scenario": "Credential Discovery",
  "description": "Simulates an attacker searching for credentials, secrets, SSH keys, API tokens, configuration files, and authentication artifacts after obtaining shell access.",
  "version": "1.0",
  "platform": "Linux",
  "phases": [
    {
      "phase": "User Identification",
      "mitre_tactic": "Discovery",
      "mitre_id": "TA0007",
      "commands": [
        {
          "command": "whoami",
          "purpose": "Identify current user",
          "severity": "Low"
        },
        {
          "command": "id",
          "purpose": "Display user and group information",
          "severity": "Low"
        },
        {
          "command": "groups",
          "purpose": "List user groups",
          "severity": "Low"
        },
        {
          "command": "users",
          "purpose": "List logged-in users",
          "severity": "Low"
        },
        {
          "command": "who",
          "purpose": "Identify active sessions",
          "severity": "Low"
        },
        {
          "command": "w",
          "purpose": "Display logged-in users and activity",
          "severity": "Low"
        }
      ]
    },

    {
      "phase": "Home Directory Enumeration",
      "mitre_tactic": "Discovery",
      "mitre_id": "TA0007",
      "commands": [
        {
          "command": "pwd",
          "purpose": "Determine current directory",
          "severity": "Low"
        },
        {
          "command": "ls -la",
          "purpose": "List hidden files",
          "severity": "Low"
        },
        {
          "command": "find ~ -maxdepth 2",
          "purpose": "Enumerate user files",
          "severity": "Low"
        },
        {
          "command": "tree -L 2",
          "purpose": "View directory structure",
          "severity": "Low"
        }
      ]
    },

    {
      "phase": "Shell History Discovery",
      "mitre_tactic": "Credential Access",
      "mitre_id": "TA0006",
      "commands": [
        {
          "command": "history",
          "purpose": "Inspect command history",
          "severity": "Medium"
        },
        {
          "command": "cat ~/.bash_history",
          "purpose": "Search previous commands",
          "severity": "Medium"
        },
        {
          "command": "cat ~/.zsh_history",
          "purpose": "Inspect zsh history",
          "severity": "Medium"
        },
        {
          "command": "grep -i password ~/.bash_history",
          "purpose": "Search for passwords in history",
          "severity": "High"
        },
        {
          "command": "grep -i ssh ~/.bash_history",
          "purpose": "Look for SSH commands",
          "severity": "Medium"
        }
      ]
    },

    {
      "phase": "SSH Credential Discovery",
      "mitre_tactic": "Credential Access",
      "mitre_id": "TA0006",
      "commands": [
        {
          "command": "ls -la ~/.ssh",
          "purpose": "Enumerate SSH directory",
          "severity": "Medium"
        },
        {
          "command": "cat ~/.ssh/config",
          "purpose": "Read SSH configuration",
          "severity": "Medium"
        },
        {
          "command": "cat ~/.ssh/known_hosts",
          "purpose": "Identify previously accessed hosts",
          "severity": "Medium"
        },
        {
          "command": "cat ~/.ssh/authorized_keys",
          "purpose": "Inspect authorized SSH keys",
          "severity": "High"
        },
        {
          "command": "find /home -name id_rsa",
          "purpose": "Locate private SSH keys",
          "severity": "High"
        },
        {
          "command": "find /home -name '*.pem'",
          "purpose": "Locate PEM key files",
          "severity": "High"
        }
      ]
    },

    {
      "phase": "Configuration File Discovery",
      "mitre_tactic": "Credential Access",
      "mitre_id": "TA0006",
      "commands": [
        {
          "command": "find /etc -name '*.conf'",
          "purpose": "Locate configuration files",
          "severity": "Medium"
        },
        {
          "command": "find /etc -name '*.cnf'",
          "purpose": "Locate database configs",
          "severity": "Medium"
        },
        {
          "command": "find /etc -name '*.ini'",
          "purpose": "Locate application configs",
          "severity": "Medium"
        },
        {
          "command": "grep -Ri password /etc 2>/dev/null",
          "purpose": "Search configuration files for passwords",
          "severity": "High"
        },
        {
          "command": "grep -Ri secret /etc 2>/dev/null",
          "purpose": "Search for secrets",
          "severity": "High"
        }
      ]
    },

    {
      "phase": "Environment Variable Discovery",
      "mitre_tactic": "Credential Access",
      "mitre_id": "TA0006",
      "commands": [
        {
          "command": "env",
          "purpose": "Display environment variables",
          "severity": "Medium"
        },
        {
          "command": "printenv",
          "purpose": "Print environment variables",
          "severity": "Medium"
        },
        {
          "command": "echo $PATH",
          "purpose": "Inspect PATH variable",
          "severity": "Low"
        },
        {
          "command": "printenv | grep -i token",
          "purpose": "Search for tokens",
          "severity": "High"
        },
        {
          "command": "printenv | grep -i key",
          "purpose": "Search for API keys",
          "severity": "High"
        },
        {
          "command": "printenv | grep -i secret",
          "purpose": "Search for secrets",
          "severity": "High"
        }
      ]
    },

    {
      "phase": "Application Credential Discovery",
      "mitre_tactic": "Credential Access",
      "mitre_id": "TA0006",
      "commands": [
        {
          "command": "find /var/www -name '.env'",
          "purpose": "Locate Laravel environment files",
          "severity": "High"
        },
        {
          "command": "find /var/www -name 'config.php'",
          "purpose": "Locate PHP configuration files",
          "severity": "Medium"
        },
        {
          "command": "find /var/www -name 'wp-config.php'",
          "purpose": "Locate WordPress configuration",
          "severity": "High"
        },
        {
          "command": "find /var/www -name 'settings.py'",
          "purpose": "Locate Django configuration",
          "severity": "Medium"
        },
        {
          "command": "find /opt -name '.env'",
          "purpose": "Search application environment files",
          "severity": "High"
        }
      ]
    },

    {
      "phase": "Database Credential Discovery",
      "mitre_tactic": "Credential Access",
      "mitre_id": "TA0006",
      "commands": [
        {
          "command": "find / -name my.cnf 2>/dev/null",
          "purpose": "Locate MySQL configuration",
          "severity": "High"
        },
        {
          "command": "find / -name pg_hba.conf 2>/dev/null",
          "purpose": "Locate PostgreSQL configuration",
          "severity": "Medium"
        },
        {
          "command": "find / -name redis.conf 2>/dev/null",
          "purpose": "Locate Redis configuration",
          "severity": "Medium"
        },
        {
          "command": "find / -name '*.db' 2>/dev/null",
          "purpose": "Locate SQLite databases",
          "severity": "Medium"
        }
      ]
    },

    {
      "phase": "Sensitive File Search",
      "mitre_tactic": "Credential Access",
      "mitre_id": "TA0006",
      "commands": [
        {
          "command": "find /home -iname '*password*'",
          "purpose": "Search password-related files",
          "severity": "High"
        },
        {
          "command": "find /home -iname '*secret*'",
          "purpose": "Search secret files",
          "severity": "High"
        },
        {
          "command": "find /home -iname '*token*'",
          "purpose": "Search token files",
          "severity": "High"
        },
        {
          "command": "find /home -iname '*.kdbx'",
          "purpose": "Locate KeePass databases",
          "severity": "High"
        },
        {
          "command": "find /home -iname '*.ovpn'",
          "purpose": "Locate VPN configurations",
          "severity": "Medium"
        }
      ]
    }
  ]
}