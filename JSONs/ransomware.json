      "mitre_id": "TA0007",
      "commands": [
        {
          "id": "RANSOM-001",
          "command": "whoami",
          "purpose": "Identify current user",
          "severity": "Low",
          "expected_outcome": "Username",
          "continue_on_failure": true
        },
        {
          "id": "RANSOM-002",
          "command": "id",
          "purpose": "Determine privileges",
          "severity": "Low",
          "expected_outcome": "UID/GID",
          "continue_on_failure": true
        },
        {
